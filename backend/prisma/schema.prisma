generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(user)
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  leads    Lead[]
}

model Session {
  id           String   @id @default(cuid())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([refreshToken])
}

model Lead {
  id          Int          @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String       @unique
  phone       String?
  company     String
  position    String
  source      LeadSource
  status      LeadStatus
  statusOrder Int          @default(0)
  manager     String
  dealAmount  Int          @default(0)
  currency    String       @default("RUB")
  city        String
  industry    String
  notes       String?
  createdById Int?
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  closedAt    DateTime?

  @@index([status])
  @@index([source])
  @@index([manager])
  @@index([createdAt])
  @@index([industry])
  @@index([createdById])
}

enum Role {
  user
  admin
}

enum LeadSource {
  website
  referral
  cold_call
  email
  social
  event
  partner
}

enum LeadStatus {
  new
  contacted
  qualified
  proposal
  negotiation
  won
  lost
}